{
  "ownerName": "Sam",
  "agentName": "Assistant",
  "timeZone": "America/New_York",
  "keychainService": "whatsapp-agent-kit",
  "jobLimitMinutes": 30,
  "onItAfterSeconds": 60,
  "whisperModel": "base.en",
  "nameHints": [],
  "model": {
    "type": "claude-code",
    "allowedTools": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch"
    ],
    "addDirs": []
  },
  "logDays": 30,
  "live": {
    "enabled": false,
    "pickupMinutes": 3
  },
  "otherModelChoices (copy one into \"model\" above)": [
    {
      "type": "claude-code",
      "model": "sonnet",
      "allowedTools": [
        "Read",
        "Write",
        "Edit",
        "Glob",
        "Grep",
        "Bash",
        "WebSearch",
        "WebFetch"
      ],
      "addDirs": [
        "~/Documents"
      ]
    },
    {
      "type": "codex",
      "sandbox": "workspace-write"
    },
    {
      "type": "anthropic",
      "model": "claude-opus-5-5",
      "keychainService": "whatsapp-agent-kit-model"
    },
    {
      "type": "openai-compatible",
      "baseUrl": "https://api.openai.com/v1",
      "model": "gpt-5",
      "keychainService": "whatsapp-agent-kit-model"
    },
    {
      "type": "openai-compatible",
      "baseUrl": "https://openrouter.ai/api/v1",
      "model": "meta-llama/llama-4-maverick",
      "keychainService": "whatsapp-agent-kit-model"
    },
    {
      "type": "openai-compatible",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "model": "gemini-2.5-flash",
      "keychainService": "whatsapp-agent-kit-model"
    },
    {
      "type": "openai-compatible",
      "baseUrl": "http://localhost:11434/v1",
      "model": "llama3.2"
    },
    {
      "type": "command",
      "command": [
        "llm",
        "-m",
        "gpt-4o-mini"
      ],
      "systemInPrompt": true
    }
  ]
}
